{
  "mcpServers": {
    "hipohipo": {
      "command": "./hipohipo",
      "args": ["mcp", "--host", "codex"],
      "cwd": ".",
      "env_vars": [
        "CODEX_HOME",
        "HIPO_RUNTIME_CACHE_DIR",
        "HIPO_RUNTIME_CONFIG_DIR",
        "HIPO_CODEX_STATE_DIR",
        "HIPO_PLUGIN_CREDENTIAL_SERVICE",
        "HIPO_PLUGIN_DEVELOPMENT",
        "HIPO_TELEMETRY_ENABLED",
        "HIPO_RUNTIME_DOWNLOAD_TIMEOUT_SECONDS",
        "HIPO_RUNTIME_DOWNLOAD_ATTEMPTS",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "ALL_PROXY",
        "NO_PROXY",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME"
      ]
    }
  }
}
